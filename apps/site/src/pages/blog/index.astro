---
import Base from "../../layouts/Base.astro";
import { SITE, YEAR } from "../../site.config";
import { NAV, FOOTER_GROUPS } from "../../lib/nav";
import { SiteFooter } from "@/components/ui/site-footer";
import { getPublishedPosts, formatDate } from "../../lib/posts";
import { SiteHeader, SkipLink } from "@/components/ui/site-nav";
import { PageBlock, Stack, Inline } from "@/components/ui/layout";

const posts = await getPublishedPosts();


import { withBase } from "@/lib/base";
---

<Base
  title="Blog"
  description={`Articles from ${SITE.name}.`}
  type="website"
>
  <SkipLink />
  <SiteHeader
    brand={SITE.name}
    brandHref="/"
    items={NAV}
    currentPath={Astro.url.pathname}
    width="narrow"
  />

  <PageBlock width="narrow" gutter="md" as="main" id="main" tabIndex={-1} className="py-3xl">
    <Stack space="xl">
      <h1 class="text-3xl">Blog</h1>

      <Stack space="lg" dividers>
        {
          posts.map((post) => {
            const d = formatDate(post.data.date);
            return (
              <article>
                <Stack space="2xs">
                  {/* 日付は必ず <time datetime> で出します。
                      「2026年8月1日」という文字列だけでは機械が読めません。 */}
                  <time datetime={d.iso} class="text-xs text-muted-fg">
                    {d.text}
                  </time>
                  <h2 class="text-xl">
                    <a href={withBase(`/blog/${post.id}/`)} class="hover:text-primary">
                      {post.data.title}
                    </a>
                  </h2>
                  {/* **行長を止めます。** 器いっぱいだと 48em になり、
                      欧文の上限 40em を超えます。和文の説明文は同じ内容でも
                      文字数が半分ほどなので、訳すまで当たりませんでした。 */}
                  <p class="max-w-[var(--width-prose)] text-sm leading-relaxed text-muted-fg">
                    {post.data.description}
                  </p>
                  {post.data.tags.length > 0 && (
                    <Inline space="2xs">
                      {post.data.tags.map((tag) => (
                        <span class="rounded-md bg-muted px-2 py-0.5 text-xs text-muted-fg">
                          {tag}
                        </span>
                      ))}
                    </Inline>
                  )}
                </Stack>
              </article>
            );
          })
        }
      </Stack>

      {posts.length === 0 && <p class="text-sm text-muted-fg">No articles yet.</p>}
    </Stack>
  </PageBlock>

  <SiteFooter
    brand={SITE.name}
    description={SITE.description}
    groups={FOOTER_GROUPS}
    note={`© ${YEAR} ${SITE.name}`}
    width="narrow"
  />
</Base>
