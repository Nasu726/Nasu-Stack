---
import Base from "../../layouts/Base.astro";
import { SITE_JA, YEAR } from "../../site.config";
import { NAV_JA, FOOTER_GROUPS_JA } from "../../lib/nav";
import { SiteHeader, SkipLink } from "@/components/ui/site-nav";
import { SiteFooter } from "@/components/ui/site-footer";
import { PageBlock, Stack, Section, Divider } from "@/components/ui/layout";
import { withBase } from "@/lib/base";

const FACTS = [
  { label: "名称", value: SITE_JA.name },
  { label: "所在地", value: "○○県○○市" },
  { label: "事業内容", value: "Web サイトおよび Web アプリケーションの設計・開発" },
  { label: "設立", value: "2026 年 4 月" },
];

const HISTORY = [
  { date: "2026-04", text: "設立" },
  { date: "2026-06", text: "サービス A の提供を開始" },
  { date: "2026-08", text: "サービス B の提供を開始" },
];
---

<Base
  title="会社概要"
  description={`${SITE_JA.name} の会社概要と沿革です。`}
  locale="ja"
  rssPath="/ja/rss.xml"
>
  <SkipLink />
  <SiteHeader
    brand={SITE_JA.name}
    brandHref="/ja/"
    items={NAV_JA}
    currentPath={Astro.url.pathname}
  />

  <PageBlock width="narrow" gutter="md" as="main" id="main" tabIndex={-1} className="py-3xl">
    <Stack space="3xl">
      <Stack space="sm">
        <h1 class="text-3xl">会社概要</h1>
        <p class="max-w-prose text-sm leading-relaxed text-muted-fg">
          小さく作って、長く直せるものを作っています。
        </p>
      </Stack>

      <Section space="md">
        <h2 class="text-xl">基本情報</h2>
        <dl class="grid grid-cols-1 gap-y-sm sm:grid-cols-[8rem_1fr] sm:gap-x-lg">
          {
            FACTS.map((fact) => (
              <>
                <dt class="text-sm font-medium text-muted-fg">{fact.label}</dt>
                <dd class="text-sm leading-relaxed">{fact.value}</dd>
              </>
            ))
          }
        </dl>
      </Section>

      <Divider />

      <Section space="md">
        <h2 class="text-xl">沿革</h2>
        <ol class="flex flex-col gap-sm">
          {
            HISTORY.map((item) => (
              <li class="flex gap-md">
                <time datetime={item.date} class="w-20 shrink-0 text-sm text-muted-fg">
                  {item.date.replace("-", "年")}月
                </time>
                <span class="min-w-0 text-sm leading-relaxed">{item.text}</span>
              </li>
            ))
          }
        </ol>
      </Section>

      <Divider />

      <Section space="md">
        <h2 class="text-xl">所在地</h2>
        <address class="text-sm not-italic leading-relaxed text-muted-fg">
          〒000-0000<br />
          ○○県○○市 0-0-0（雛型の例です。書き換えてください）
        </address>
        <p class="text-sm">
          <a href={withBase("/ja/contact/")} class="text-primary underline underline-offset-2">
            お問い合わせはこちら
          </a>
        </p>
      </Section>
    </Stack>
  </PageBlock>

  <SiteFooter
    brand={SITE_JA.name}
    brandHref="/ja/"
    description={SITE_JA.description}
    groups={FOOTER_GROUPS_JA}
    note={`© ${YEAR} ${SITE_JA.name}`}
  />
</Base>
