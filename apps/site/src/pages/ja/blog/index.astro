---
import Base from "../../../layouts/Base.astro";
import { SITE_JA, YEAR } from "../../../site.config";
import { NAV_JA, FOOTER_GROUPS_JA } from "../../../lib/nav";
import { SiteFooter } from "@/components/ui/site-footer";
import { getPublishedPosts, formatDate, postSlug } from "../../../lib/posts";
import { SiteHeader, SkipLink } from "@/components/ui/site-nav";
import { PageBlock, Stack, Inline } from "@/components/ui/layout";
import { withBase } from "@/lib/base";

const posts = await getPublishedPosts("ja");
---

<Base
  title="ブログ"
  description={`${SITE_JA.name} の記事一覧です。`}
  type="website"
  locale="ja"
  rssPath="/ja/rss.xml"
>
  <SkipLink />
  <SiteHeader
    brand={SITE_JA.name}
    brandHref="/ja/"
    items={NAV_JA}
    currentPath={Astro.url.pathname}
    width="narrow"
  />

  <PageBlock width="narrow" gutter="md" as="main" id="main" tabIndex={-1} className="py-3xl">
    <Stack space="xl">
      <h1 class="text-3xl">ブログ</h1>

      <Stack space="lg" dividers>
        {
          posts.map((post) => {
            const date = formatDate(post.data.date, "ja");
            return (
              <article>
                <Stack space="2xs">
                  <time datetime={date.iso} class="text-xs text-muted-fg">
                    {date.text}
                  </time>
                  <h2 class="text-xl">
                    <a href={withBase(`/ja/blog/${postSlug(post)}/`)} class="hover:text-primary">
                      {post.data.title}
                    </a>
                  </h2>
                  <p class="max-w-[var(--width-prose)] text-sm leading-relaxed text-muted-fg">
                    {post.data.description}
                  </p>
                  {post.data.tags.length > 0 && (
                    <Inline space="2xs">
                      {post.data.tags.map((tag) => (
                        <span class="rounded-md bg-muted px-2 py-0.5 text-xs text-muted-fg">
                          {tag}
                        </span>
                      ))}
                    </Inline>
                  )}
                </Stack>
              </article>
            );
          })
        }
      </Stack>

      {posts.length === 0 && <p class="text-sm text-muted-fg">まだ記事がありません。</p>}
    </Stack>
  </PageBlock>

  <SiteFooter
    brand={SITE_JA.name}
    brandHref="/ja/"
    description={SITE_JA.description}
    groups={FOOTER_GROUPS_JA}
    note={`© ${YEAR} ${SITE_JA.name}`}
    width="narrow"
  />
</Base>
