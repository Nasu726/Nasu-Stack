---
import { render } from "astro:content";
import Base from "../../../layouts/Base.astro";
import { SITE_JA, YEAR } from "../../../site.config";
import { NAV_JA, FOOTER_GROUPS_JA } from "../../../lib/nav";
import { SiteFooter } from "@/components/ui/site-footer";
import {
  getPublishedPosts,
  formatDate,
  postSlug,
  type Post,
} from "../../../lib/posts";
import { SiteHeader, SkipLink } from "@/components/ui/site-nav";
import { PageBlock, ContentBlock, Stack, Inline } from "@/components/ui/layout";
import { withBase } from "@/lib/base";

export async function getStaticPaths() {
  const posts = await getPublishedPosts("ja");
  return posts.map((post) => ({ params: { slug: postSlug(post) }, props: { post } }));
}

interface Props {
  post: Post;
}

const { post } = Astro.props;
const { Content } = await render(post);
const date = formatDate(post.data.date, "ja");
---

<Base
  title={post.data.title}
  description={post.data.description}
  type="article"
  publishedAt={post.data.date.toISOString()}
  updatedAt={post.data.updated?.toISOString()}
  theme="editorial"
  locale="ja"
  rssPath="/ja/rss.xml"
>
  <SkipLink />
  <SiteHeader
    brand={SITE_JA.name}
    brandHref="/ja/"
    items={NAV_JA}
    currentPath={Astro.url.pathname}
    width="narrow"
  />

  <PageBlock width="narrow" gutter="md" as="main" id="main" tabIndex={-1} className="py-3xl">
    <Stack space="xl">
      <Stack space="2xs">
        <time datetime={date.iso} class="text-xs text-muted-fg">{date.text}</time>
        <h1 class="text-3xl leading-tight">{post.data.title}</h1>
        {post.data.tags.length > 0 && (
          <Inline space="2xs">
            {post.data.tags.map((tag) => (
              <span class="rounded-md bg-muted px-2 py-0.5 text-xs text-muted-fg">
                {tag}
              </span>
            ))}
          </Inline>
        )}
      </Stack>

      <ContentBlock width="prose">
        <div class="wt-prose" lang="ja">
          <Content />
        </div>
      </ContentBlock>

      <p class="text-sm">
        <a href={withBase("/ja/blog/")} class="text-primary underline underline-offset-2">
          ← 記事一覧へ
        </a>
      </p>
    </Stack>
  </PageBlock>

  <SiteFooter
    brand={SITE_JA.name}
    brandHref="/ja/"
    description={SITE_JA.description}
    groups={FOOTER_GROUPS_JA}
    note={`© ${YEAR} ${SITE_JA.name}`}
    width="narrow"
  />
</Base>
