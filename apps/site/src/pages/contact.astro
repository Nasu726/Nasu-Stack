---
/**
 * お問い合わせの雛型。
 *
 * フォームだけが island（React）です。ページの残りは静的 HTML なので、
 * JavaScript を待たずに読めます。
 *
 * 送信先は `PUBLIC_CONTACT_ENDPOINT` で外から渡します。
 * **未設定のときだけ**、送らずに成功したふりをします（開発中に
 * 「まだ受け口が無い」だけで画面が壊れないようにするためです）。
 */
import Base from "../layouts/Base.astro";
import { SITE, YEAR } from "../site.config";
import { NAV, FOOTER_GROUPS } from "../lib/nav";
import { ContactForm } from "../components/ContactForm";
import { SiteHeader, SkipLink } from "@/components/ui/site-nav";
import { SiteFooter } from "@/components/ui/site-footer";
import { PageBlock, Stack, Columns, Column, Section } from "@/components/ui/layout";
---

<Base
  title="Contact"
  description={`Get in touch with ${SITE.name}.`}
>
  <SkipLink />
  <SiteHeader
    brand={SITE.name}
    brandHref="/"
    items={NAV}
    currentPath={Astro.url.pathname}
  />

  <PageBlock width="content" gutter="md" as="main" id="main" tabIndex={-1} className="py-3xl">
    <Stack space="xl">
      <Stack space="sm">
        <h1 class="text-3xl">Contact</h1>
        <p class="max-w-prose text-sm leading-relaxed text-muted-fg">
          Work enquiries, bug reports, anything at all.
          We reply within a few working days.
        </p>
      </Stack>

      <Columns space="xl" collapseBelow="tablet">
        <Column width="2/3">
          <div class="max-w-md">
            <ContactForm client:load />
          </div>
        </Column>
        <Column>
          <Section space="sm">
            <h2 class="text-base font-semibold">About replies</h2>
            <p class="text-sm leading-relaxed text-muted-fg">
              What you send is used only to answer your enquiry.
              If it will not send, leave it a while and try again.
            </p>
          </Section>
        </Column>
      </Columns>
    </Stack>
  </PageBlock>

  <SiteFooter
    brand={SITE.name}
    description={SITE.description}
    groups={FOOTER_GROUPS}
    note={`© ${YEAR} ${SITE.name}`}
  />
</Base>
