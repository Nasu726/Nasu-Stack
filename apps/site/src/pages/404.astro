---
import Base from "../layouts/Base.astro";
import { SITE, YEAR } from "../site.config";
import { NAV, FOOTER_GROUPS } from "../lib/nav";
import { SiteFooter } from "@/components/ui/site-footer";
import { SiteHeader, SkipLink } from "@/components/ui/site-nav";
import { PageBlock, Stack, Inline } from "@/components/ui/layout";


import { withBase } from "@/lib/base";
---

{/* 見つからないページは検索結果に載せません */}
<Base
  title="Page not found"
  description="The page you were looking for may have moved or been removed."
  noindex
>
  <SkipLink />
  <SiteHeader brand={SITE.name} brandHref="/" items={NAV} width="narrow" />

  <PageBlock width="narrow" gutter="md" as="main" id="main" tabIndex={-1} className="py-3xl">
    <Stack space="md">
      <p class="text-sm text-muted-fg">404</p>
      <h1 class="text-3xl">Page not found</h1>
      <p class="max-w-prose text-sm leading-relaxed text-muted-fg">
        The page you were looking for may have moved or been removed.
        If the URL is not a typo, try one of these.
      </p>
      <Inline space="sm">
        <a
          href={withBase("/")}
          class="inline-flex min-h-11 items-center rounded-md bg-primary px-4 text-sm font-medium text-primary-fg"
        >
          Home
        </a>
        <a
          href={withBase("/blog/")}
          class="inline-flex min-h-11 items-center rounded-md border border-border px-4 text-sm"
        >
          All articles
        </a>
      </Inline>
    </Stack>
  </PageBlock>

  <SiteFooter
    brand={SITE.name}
    description={SITE.description}
    groups={FOOTER_GROUPS}
    note={`© ${YEAR} ${SITE.name}`}
    width="narrow"
  />
</Base>
