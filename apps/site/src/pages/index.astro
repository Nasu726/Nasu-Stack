---
import Base from "../layouts/Base.astro";
import { SITE, YEAR } from "../site.config";
import { NAV, FOOTER_GROUPS } from "../lib/nav";
import { SiteFooter } from "@/components/ui/site-footer";
import { ContactForm } from "../components/ContactForm";
import { DataList } from "@/components/ui/data-list";
import { SiteHeader, SkipLink } from "@/components/ui/site-nav";
import { PageBlock, Section, Stack } from "@/components/ui/layout";

// 静的サイト側は Astro で書き、状態を持つ部分だけ island として React を差し込みます。
// ページ本体は JS 0 バイトで配信されます。
//
// ヘッダとレイアウトは配布している部品をそのまま使っています。
// **client: を付けていません。** 静的 HTML として書き出されるだけで、
// 狭い画面のメニューは <details> なので JavaScript 無しで開閉します。
// ナビとフッタの定義は 1 か所（src/lib/nav.ts）にまとめています。
// ページごとに書くと「新しいページを足したのにヘッダから辿れない」が起きます。
import { withBase } from "@/lib/base";
---

<Base
  title="Nasu Stack — a static site example"
  description={SITE.description}
  theme="editorial"
>
  <SkipLink />

  <SiteHeader
    brand={SITE.name}
    brandHref="/"
    items={NAV}
    currentPath={Astro.url.pathname}
    width="narrow"
  />

  <PageBlock width="narrow" gutter="md" as="main" id="main" tabIndex={-1} className="py-3xl">
    <Stack space="3xl">
      <Section space="sm">
        <h1 class="text-4xl leading-tight">
          Static pages in Astro.<br />React only where things move.
        </h1>
        <p class="max-w-lg text-sm leading-relaxed text-muted-fg">
          Everything you are reading is fully static HTML. Only the two spots
          below load as islands, so the first paint never waits for JavaScript.
          Both sides share the same theme tokens, so the Astro half and the
          React half cannot drift apart visually.
        </p>
      </Section>

      {/* パターン A: 関数を渡せない .astro からは、宣言（ActionSpec）で書く */}
      <Section space="sm" id="works">
        <h2 class="text-2xl">Works</h2>
        <p class="max-w-prose text-xs text-muted-fg">
          Instead of a function, this passes <code>{"{ url, method }"}</code>.
          Props from .astro are serialized to JSON, so this is the form that survives.
        </p>
        {/* **base は自分で付けます。** 下の `url` は props に渡す文字列であって、
            道具が書き換える対象ではありません。付け忘れると、サブパスに
            公開した瞬間にデータだけ 404 になります。**HTML には出ないので、
            リンクを辿る検査でも見つかりません**（実ブラウザで開いて、
            飛んだ要求を見る必要があります）。 */}
        <DataList
          client:load
          loader={{ url: withBase("/works.json"), method: "GET" }}
          columns={[
            { key: "title", primary: true },
            { key: "stack", badge: true },
            { key: "year", badge: true },
          ]}
        />
      </Section>

      {/* パターン B: 独自ロジックを持つ島は .tsx でラップする */}
      <Section space="sm" id="contact">
        <h2 class="text-2xl">Contact</h2>
        <p class="max-w-prose text-xs text-muted-fg">
          It has validation of its own, so it is loaded through a .tsx wrapper.
        </p>
        <div class="max-w-md">
          <ContactForm client:load />
        </div>
      </Section>
    </Stack>
  </PageBlock>

  <SiteFooter
    brand={SITE.name}
    description={SITE.description}
    groups={FOOTER_GROUPS}
    note={`© ${YEAR} ${SITE.name}`}
    width="narrow"
  />
</Base>
