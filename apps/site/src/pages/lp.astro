---
/**
 * ランディングページの雛型。
 *
 * **見た目のセクション集は作りません。** ヒーローや料金表の見本は
 * 既に大量に売られていて、作る価値がありません。
 * ここが用意しているのは**骨格と配線**です。
 *
 *   - 見出しの階層（h1 は 1 つ。h2 で節を切る）
 *   - 画像が場所を先に取っていること（Astro の Image + Frame）
 *   - よくある質問は <details>（JavaScript 無しで開閉する）
 *   - landmark（header / main / footer / nav）
 */
import { Image } from "astro:assets";
import Base from "../layouts/Base.astro";
import { SITE, YEAR } from "../site.config";
import { NAV, FOOTER_GROUPS } from "../lib/nav";
import { SiteHeader, SkipLink } from "@/components/ui/site-nav";
import { SiteFooter } from "@/components/ui/site-footer";
import { Accordion } from "@/components/ui/disclosure";
import { Frame } from "@/components/ui/frame";
import {
  PageBlock,
  ContentBlock,
  Stack,
  Inline,
  Columns,
  Column,
  Tiles,
  Section,
} from "@/components/ui/layout";
import hero from "../assets/hero.png";
import featureA from "../assets/feature-a.png";
import featureB from "../assets/feature-b.png";
import featureC from "../assets/feature-c.png";

const FEATURES = [
  {
    image: featureA,
    title: "No spacing decisions",
    body: "Pick from nine spacing steps. Values outside them still work, so you can tighten things up once you know what you want.",
  },
  {
    image: featureB,
    title: "No state to write",
    body: "Submitting, success, failure, and the double-submit guard are all handled for you. You hand over one function.",
  },
  {
    image: featureC,
    title: "Nothing breaks when narrow",
    body: "Long URLs and wide tables are absorbed by the foundation. Breakage is checked with numbers, not by eye.",
  },
];

const FAQ = [
  {
    summary: "Can I use this without writing code?",
    content:
      "It assumes you can touch code a little. If you never write any, a tool that builds from plain language will suit you better.",
  },
  {
    summary: "Can I change things freely afterwards?",
    content:
      "Yes. What comes out is ordinary TypeScript and CSS, with no proprietary save format. When a component stops fitting, rewrite it.",
  },
  {
    summary: "Which backend should I use?",
    content:
      "Whichever you like. All a component knows is the contract (input, ctx) => Promise<output>. It never reaches past that.",
  },
];
import { withBase } from "@/lib/base";
---

<Base
  title="Build without stalling, change it freely later"
  description="Spacing and async state are handled for you. What comes out is ordinary code, so you can change it freely later."
>
  <SkipLink />
  <SiteHeader
    brand={SITE.name}
    brandHref="/"
    items={NAV}
    currentPath={Astro.url.pathname}
  />

  <main id="main" tabindex="-1">
    {/* ヒーロー。h1 はページに 1 つだけ。 */}
    <PageBlock width="content" gutter="md" className="pt-3xl">
      <Columns space="xl" collapseBelow="tablet" alignY="center">
        <Column>
          <Stack space="md">
            <h1 class="text-4xl leading-tight">
              Build without stalling.<br />Change it freely later.
            </h1>
            <p class="max-w-prose text-base leading-relaxed text-muted-fg">
              The two places beginners always get stuck — <strong class="text-fg">layout</strong> and
              <strong class="text-fg">async state</strong> — are handled by the components.
              What comes out is ordinary TypeScript, so you can rewrite it as soon as you want to.
            </p>
            <Inline space="sm">
              <a
                href={withBase("/contact/")}
                class="inline-flex min-h-11 items-center rounded-md bg-primary px-5 text-sm font-medium text-primary-fg hover:opacity-90"
              >
                Get in touch
              </a>
              <a
                href={withBase("/blog/")}
                class="inline-flex min-h-11 items-center rounded-md border border-border px-5 text-sm hover:bg-muted"
              >
                Read how it works
              </a>
            </Inline>
          </Stack>
        </Column>
        <Column>
          {/* 最初の画面に入る画像なので遅延読み込みにしません。
              Frame が比率を先に確保するので、届いても本文が動きません。 */}
          <Frame ratio="16/9" radius="xl">
            <Image src={hero} alt="" loading="eager" fetchpriority="high" />
          </Frame>
        </Column>
      </Columns>
    </PageBlock>

    <PageBlock width="content" gutter="md" className="py-3xl">
      <Stack space="3xl">
        <Section space="lg">
          <h2 class="text-2xl">Three things it takes over</h2>
          <Tiles columns={{ mobile: 1, tablet: 3, desktop: 3 }} space="lg">
            {
              FEATURES.map((f) => (
                <Stack space="sm">
                  <Frame ratio="4/3" radius="lg">
                    <Image src={f.image} alt="" />
                  </Frame>
                  <h3 class="text-base font-semibold">{f.title}</h3>
                  <p class="text-sm leading-relaxed text-muted-fg">{f.body}</p>
                </Stack>
              ))
            }
          </Tiles>
        </Section>

        <Section space="lg">
          <h2 class="text-2xl">Questions we get</h2>
          <ContentBlock width="prose">
            {/* <details> なので JavaScript 無しで開閉します。
                Ctrl+F のページ内検索も、閉じた中身を見つけてくれます。 */}
            <Accordion items={FAQ} />
          </ContentBlock>
        </Section>

        <Section space="md">
          <h2 class="text-2xl">Start with one page</h2>
          <p class="max-w-prose text-sm leading-relaxed text-muted-fg">
            This page is itself one of the templates. Start by swapping out the content.
          </p>
          <Inline space="sm">
            <a
              href={withBase("/contact/")}
              class="inline-flex min-h-11 items-center rounded-md bg-primary px-5 text-sm font-medium text-primary-fg hover:opacity-90"
            >
              Get in touch
            </a>
          </Inline>
        </Section>
      </Stack>
    </PageBlock>
  </main>

  <SiteFooter
    brand={SITE.name}
    description={SITE.description}
    groups={FOOTER_GROUPS}
    note={`© ${YEAR} ${SITE.name}`}
  />
</Base>
