---
import "../styles/global.css";

interface Props {
  title: string;
  description?: string;
  /** 既定のトンマナ。ページ単位で変えられます。 */
  theme?: "neutral" | "warm" | "editorial" | "vivid";
}

const { title, description = "", theme = "warm" } = Astro.props;
---

<!doctype html>
<html lang="ja" data-theme={theme}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    {description && <meta name="description" content={description} />}

    <!-- 保存済みのテーマを描画前に適用してちらつきを防ぐ -->
    <script is:inline>
      (function () {
        try {
          var s = localStorage.getItem("webtemplate.theme");
          var v = s ? JSON.parse(s) : {};
          if (v.theme) document.documentElement.dataset.theme = v.theme;
          var m = v.mode || "system";
          var dark =
            m === "dark" ||
            (m === "system" &&
              matchMedia("(prefers-color-scheme: dark)").matches);
          document.documentElement.classList.toggle("dark", dark);
        } catch (e) {}
      })();
    </script>
  </head>

  <body class="min-h-dvh bg-bg text-fg">
    <slot />
  </body>
</html>
